# Frontend-only keys. Never put WhatsApp tokens or service-role / sb_secret keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use Project Settings → API → Publishable key (sb_publishable_…) or legacy anon JWT (eyJ…)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave unset for Connected Mode default: wa.me (not Cloud API)
VITE_MESSAGING_MODE=

# Canonical public origin for share links, OG/canonical, QR, and magic-link redirects.
# Local: http://localhost:5173 | Production (Netlify): https://invana.stream
VITE_PUBLIC_SITE_URL=https://invana.stream

# Require sign-in for Download in Connected Mode (default: true).
# Publish and Share always require sign-in when Connected. Demo Mode never gates.
# VITE_REQUIRE_SIGN_IN=true

# Google Analytics 4 — template clicks, previews, downloads (leave unset to disable)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
