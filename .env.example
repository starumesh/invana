# Frontend-only keys. Never put WhatsApp tokens or service-role / sb_secret keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use Project Settings → API → Publishable key (sb_publishable_…) or legacy anon JWT (eyJ…)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave unset for Connected Mode default: wa.me (not Cloud API)
VITE_MESSAGING_MODE=

# Magic-link redirect + share/QR origin (Vite default port)
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Require sign-in for Download / Publish / Share in Connected Mode (default: true).
# Set to false to allow those actions without an account. Demo Mode never gates.
# VITE_REQUIRE_SIGN_IN=true

# Optional: override Connected Mode OTP (default 123456). Do not expose in UI copy.
# VITE_DEV_OTP=123456
